# Templat variabel lingkungan. Salin ke `.env` di root repo lalu isi:
#   cp env.example .env
# File .env tidak di-commit (lihat .gitignore).

# Database (docker compose membaca nilai ini; bawaan pengembangan lokal)
POSTGRES_USER=itapp
POSTGRES_PASSWORD=itapp
POSTGRES_DB=itapp
DATABASE_URL=postgres://itapp:itapp@localhost:5432/itapp

# Better Auth — rahasia acak minimal 32 karakter: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Akun Manajer awal (dibuat oleh `pnpm --filter @workspace/auth db:seed`,
# wajib ganti kata sandi saat login pertama)
SEED_MANAGER_USERNAME=manajer
SEED_MANAGER_PASSWORD=

# Penyimpanan file (RustFS, API S3). S3_ENDPOINT = alamat internal untuk server,
# S3_PUBLIC_URL = alamat yang dijangkau browser (dipakai menandatangani URL).
# Harus origin tanpa path (mis. https://files.domain); path dibuang saat menandatangani URL.
# APP_ORIGIN = satu-satunya origin yang diizinkan CORS bucket (diatur layanan rustfs-init).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=konten
S3_REGION=us-east-1
APP_ORIGIN=http://localhost:3000

# SSO Simtama ID (opsional; kosongkan untuk menonaktifkan tombol SSO).
# Minta admin IdP mendaftarkan klien dengan redirect persis:
#   ${BETTER_AUTH_URL}/api/auth/callback/simtama
# Base URL tanpa trailing slash. Secret hanya di server.
SIMTAMA_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

