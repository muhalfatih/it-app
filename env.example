# Templat variabel lingkungan. Salin ke `.env` di root repo lalu isi:
#   cp env.example .env
# File .env tidak di-commit (lihat .gitignore).

# Database (docker compose membaca nilai ini; bawaan pengembangan lokal)
POSTGRES_USER=itapp
POSTGRES_PASSWORD=itapp
POSTGRES_DB=itapp
DATABASE_URL=postgres://itapp:itapp@localhost:5432/itapp

# Better Auth — rahasia acak minimal 32 karakter: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Manajer (hanya satu yang aktif). `pnpm --filter @workspace/auth db:seed` menjadikan username
# Simtama ID ini Manajer (akun dibuat bila belum ada) dan melepas peran Manajer dari akun lain.
SEED_MANAGER_USERNAME=manajer

# Penyimpanan file (RustFS, API S3). S3_ENDPOINT = alamat internal untuk server,
# S3_PUBLIC_URL = alamat yang dijangkau browser (dipakai menandatangani URL).
# Harus origin tanpa path (mis. https://files.domain); path dibuang saat menandatangani URL.
# APP_ORIGIN = satu-satunya origin yang diizinkan CORS bucket (diatur layanan rustfs-init).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=konten
S3_REGION=us-east-1
APP_ORIGIN=http://localhost:3000

# Notifikasi push (Web Push VAPID). Buat sepasang kunci: pnpm dlx web-push generate-vapid-keys
# Tanpa ketiganya, push dimatikan (aksi tetap jalan, hanya dicatat di log).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# SSO Simtama ID (WAJIB: satu-satunya cara masuk; tanpa ini tidak ada yang bisa masuk).
# Minta admin IdP mendaftarkan klien dengan redirect persis:
#   ${BETTER_AUTH_URL}/api/auth/callback/simtama
# Base URL tanpa trailing slash. Secret hanya di server.
SIMTAMA_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Direktori Simtama (opsional; Setting → Akun memilih pegawai dari Simtama dan memberi
# aksesnya). Simtama Console → Service client, scope: console:accounts:read
# console:access:read console:access:write console:access-levels:read.
# Produksi: batasi service client ke IP server (scope access:write berlaku ke semua aplikasi).
SIMTAMA_API_URL=https://demo-api.simtama.net/v1
SIMTAMA_SERVICE_CLIENT_ID=
SIMTAMA_SERVICE_CLIENT_SECRET=
# id numerik aplikasi ini (Simtama Console → Aplikasi & SSO); demo: 26
SIMTAMA_APPLICATION_ID=
