# Templat variabel lingkungan. Satu .env di root repo dipakai semua paket dan docker compose:
#   cp env.example .env
# .env tidak di-commit (lihat .gitignore).
#
# Nilai di bawah adalah bawaan pengembangan lokal. Di PRODUKSI wajib diganti:
#   - BETTER_AUTH_URL, APP_ORIGIN  -> https://app.domainmu
#   - S3_PUBLIC_URL                -> https://files.domainmu
#   - BETTER_AUTH_SECRET baru; POSTGRES_PASSWORD, S3_ACCESS_KEY, S3_SECRET_KEY diganti nilai acak
# Semua URL berupa origin tanpa path dan tanpa trailing slash.
#
# Di dalam docker compose, DATABASE_URL dan S3_ENDPOINT ditimpa ke alamat internal (db:5432,
# rustfs:9000); nilai localhost di sini hanya untuk `pnpm dev` dari host.

# ---------------------------------------------------------------------------
# Database (WAJIB)
# ---------------------------------------------------------------------------
POSTGRES_USER=itapp
POSTGRES_PASSWORD=itapp
POSTGRES_DB=itapp
# Harus cocok dengan tiga nilai di atas.
DATABASE_URL=postgres://itapp:itapp@localhost:5432/itapp

# ---------------------------------------------------------------------------
# Better Auth (WAJIB)
# ---------------------------------------------------------------------------
# Rahasia acak minimal 32 karakter: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origin yang dibuka browser.
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SSO Simtama ID (WAJIB: satu-satunya cara masuk; tanpa ini tidak ada yang bisa masuk)
# ---------------------------------------------------------------------------
# Minta admin IdP mendaftarkan klien dengan redirect persis:
#   ${BETTER_AUTH_URL}/api/auth/callback/simtama
# Secret hanya di server.
SIMTAMA_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Seed Manajer (WAJIB untuk `pnpm --filter @workspace/auth db:seed`)
# ---------------------------------------------------------------------------
# Hanya satu Manajer aktif. Seed menjadikan username Simtama ID ini Manajer (akun dibuat bila
# belum ada) dan melepas peran Manajer dari akun lain.
SEED_MANAGER_USERNAME=manajer

# ---------------------------------------------------------------------------
# Penyimpanan file: RustFS, API S3 (WAJIB)
# ---------------------------------------------------------------------------
# Alamat yang dipakai server (compose menimpanya ke http://rustfs:9000).
S3_ENDPOINT=http://localhost:9000
# Alamat yang dijangkau browser; dipakai menandatangani URL (path dibuang).
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=konten
S3_REGION=us-east-1
# Satu-satunya origin yang diizinkan CORS bucket (diatur layanan rustfs-init saat `up`).
APP_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Notifikasi push, Web Push VAPID (opsional)
# ---------------------------------------------------------------------------
# Buat pasangan kunci: pnpm dlx web-push generate-vapid-keys
# Tanpa ketiganya push dimatikan (aksi tetap jalan, hanya dicatat di log).
# NEXT_PUBLIC_* ditanam saat build: setelah mengganti, jalankan `docker compose up -d --build`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Direktori Simtama (opsional: Setting -> Akun memilih pegawai dari Simtama dan memberi aksesnya)
# ---------------------------------------------------------------------------
# Simtama Console -> Service client, scope: console:accounts:read console:access:read
# console:access:write console:access-levels:read.
# Produksi: batasi service client ke IP server (scope access:write berlaku ke semua aplikasi).
SIMTAMA_API_URL=https://demo-api.simtama.net/v1
SIMTAMA_SERVICE_CLIENT_ID=
SIMTAMA_SERVICE_CLIENT_SECRET=
# Id numerik aplikasi ini (Simtama Console -> Aplikasi & SSO); demo: 26
SIMTAMA_APPLICATION_ID=
